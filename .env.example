# ==== Proveedores LLM ====
# La ingesta y la evaluación de retrieval NO necesitan claves (embeddings locales).
# La generación y el juez de groundedness necesitan al menos una.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ==== Servicio ====
# mock: respuesta extractiva sin red, sirve para probar la instalación (no mide calidad).
DEFAULT_PROVIDER=mock
MAX_RETRIES=2
REQUEST_TIMEOUT_S=60

# ==== Índice y modelos locales ====
INDEX_DIR=data/index
MODELS_DIR=data/models

# ==== Observabilidad ====
METRICS_PATH=data/metrics.jsonl
LOG_LEVEL=INFO
